#!/usr/bin/env bash
# Fail the commit if any numbers.json key has no computing writer.
# Install:  ln -sf ../../hooks/pre-commit .git/hooks/pre-commit
set -e
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '^(paper/numbers\.json|scripts/.*\.py)$'; then
    .venv/bin/python -m scripts.check_coverage --test
    .venv/bin/python -m scripts.check_coverage
    .venv/bin/python -m scripts.check_tables
fi
